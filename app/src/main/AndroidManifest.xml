<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.firebaseprojek">
    <!-- ===== PERMISSION INTERNET ===== -->
    <uses-permission android:name="android.permission.INTERNET" /> <!-- ===== PERMISSION CAMERA ===== -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" /> <!-- ===== PERMISSION LOCATION ===== -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" /> <!-- ===== PERMISSION STORAGE ===== -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" /> <!-- ===== QUERIES (Android 11+) ===== -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />

            <data android:scheme="geo" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FirebaseProjek"
        tools:targetApi="31">
        <activity
            android:name=".LaporanUmumActivity"
            android:exported="false" />
        <!-- ===== GOOGLE MAPS API KEY ===== -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="YOUR_API_KEY" /> <!-- ===== MAIN ACTIVITY (LOGIN/LAUNCHER) ===== -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- ===== REGISTER ACTIVITY ===== -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" /> <!-- ===== MENU ACTIVITY ===== -->
        <activity
            android:name=".MenuActivity"
            android:exported="false" /> <!-- ===== LAPORAN ACTIVITIES ===== -->
        <activity
            android:name=".LaporanKebakaranActivity"
            android:exported="false" />
        <activity
            android:name=".LaporanMedisActivity"
            android:exported="false" />
        <activity
            android:name=".LaporanPencurianActivity"
            android:exported="false" /> <!-- ===== RIWAYAT LAPORAN ACTIVITY ===== -->
        <activity
            android:name=".RiwayatLaporanActivity"
            android:exported="false" /> <!-- ===== PILIH LOKASI ACTIVITY ===== -->
        <activity
            android:name=".PilihLokasiActivity"
            android:exported="false"
            android:label="@string/title_activity_pilih_lokasi" />
    </application>

</manifest>